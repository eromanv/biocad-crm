# OpenRouter (required for chat — leave empty for compose health stubs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Chat guardrails
CHAT_ENABLED=true
CHAT_MAX_ROUNDS=3
CHAT_MAX_INPUT_LEN=500
CHAT_MAX_RESPONSE_LEN=2000
CHAT_RATE_LIMIT=10

# Host ports (non-classic neighbors of 5173/8000/5432)
FRONTEND_PORT=5174
BACKEND_PORT=8001
MCP_PORT=8101
POSTGRES_PORT=5433

# Postgres (internal hostname `db`, port 5432 on the compose network)
POSTGRES_USER=biocad
POSTGRES_PASSWORD=biocad
POSTGRES_DB=biocad
# Hostname `db` is the compose service. Host tools (alembic) rewrite it to localhost.
DATABASE_URL=postgresql+asyncpg://biocad:biocad@db:5432/biocad

# MCP (backend → mcp by service name)
MCP_URL=http://mcp:8101/mcp

# Frontend → backend (browser hits host-mapped port)
VITE_API_URL=http://localhost:8001

# Backend CORS (browser origin of the Vite UI)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Production (docker-compose.prod.yml): public origin of the nginx UI
# CORS_ORIGINS=https://your.domain
# HTTP_PORT=80
# Use a unique POSTGRES_PASSWORD / DATABASE_URL — do not ship the example password.
