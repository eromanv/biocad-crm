meta {
  name: Import plan Excel
  type: http
  seq: 2
}

# Clears chat session history for the request cookie (biocad_chat_sid) after a successful import.

post {
  url: {{backendUrl}}/api/plan/import
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(../../examples/sample-plan.xlsx)
}
